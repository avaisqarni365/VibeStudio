{
  "name": "vibestudio",
  "version": "0.0.1",
  "private": true,
  "description": "Vibe Code Prompt Studio — modernised standalone of ACCA's dev portal. Project management + sprint board + AI prompt library + wiki + activity feed for vibe-coding teams.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "domains/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo dev --filter=@vibestudio/api",
    "dev:web": "turbo dev --filter=@vibestudio/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "knex --knexfile infrastructure/knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile infrastructure/knexfile.js migrate:rollback",
    "db:seed": "knex --knexfile infrastructure/knexfile.js seed:run",
    "db:reset": "npm run db:rollback && npm run db:migrate && npm run db:seed",
    "test": "turbo test",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.3.3",
    "prettier": "^3.2.5",
    "vitest": "^2.1.9",
    "@types/node": "^20.11.0"
  },
  "engines": {
    "node": ">=20"
  }
}
