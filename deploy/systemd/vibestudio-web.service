[Unit]
Description=VibeStudio Web (Next.js)
After=network.target vibestudio-api.service
Wants=network.target

[Service]
Type=simple
User=vibestudio
Group=vibestudio
WorkingDirectory=/srv/vibestudio/apps/web
EnvironmentFile=/srv/vibestudio/.env.production
ExecStart=/usr/bin/npx next start -p 3100
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/vibestudio/web.log
StandardError=append:/var/log/vibestudio/web.err.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/vibestudio /var/log/vibestudio

[Install]
WantedBy=multi-user.target
