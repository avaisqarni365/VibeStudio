[Unit]
Description=VibeStudio API (Express)
After=network.target postgresql.service
Wants=network.target

[Service]
Type=simple
User=vibestudio
Group=vibestudio
WorkingDirectory=/srv/vibestudio
EnvironmentFile=/srv/vibestudio/.env.production
ExecStart=/usr/bin/node apps/api/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/vibestudio/api.log
StandardError=append:/var/log/vibestudio/api.err.log

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/vibestudio /var/log/vibestudio

[Install]
WantedBy=multi-user.target
