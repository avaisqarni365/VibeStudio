# VibeStudio production env — copy to /srv/vibestudio/.env.production
# Owner: vibestudio:vibestudio   Mode: 0640

# Database — direct (Postgres running on the same VM)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vibestudio
DB_USER=vibestudio
DB_PASSWORD=__REPLACE_ME__

# No SSH tunnel needed in prod (we're already on the VM)
# Set these blank to short-circuit the tunnel check:
TUNNEL_REMOTE_HOST=
TUNNEL_REMOTE_PORT=
TUNNEL_LOCAL_PORT=
TUNNEL_SSH_USER=
TUNNEL_SSH_KEY=

# Server
PORT=4100
WEB_PORT=3100
NODE_ENV=production
WEB_ORIGIN=https://vibestudio.codes-ai.uk
NEXT_PUBLIC_API_URL=https://vibestudio.codes-ai.uk

# Auth — generate with `openssl rand -hex 32`
JWT_SECRET=__REPLACE_ME__
JWT_REFRESH_SECRET=__REPLACE_ME__
MOBILE_DEPLOY_KEY=__REPLACE_ME__

# AI providers (set what you actually use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=

# Mobile deploy (Expo / EAS) — optional
EXPO_TOKEN=

# Logging
LOG_LEVEL=info
