# VibeStudio environment template

# Database (own Postgres recommended for VibeStudio — separate from ACCA)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vibestudio
DB_USER=vibestudio
DB_PASSWORD=__REPLACE_ME__

# Server
PORT=4100
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4100

# Auth
JWT_SECRET=__REPLACE_ME_AT_LEAST_32_CHARS__
JWT_REFRESH_SECRET=__REPLACE_ME__
MOBILE_DEPLOY_KEY=__REPLACE_ME__   # AES-256-GCM key (or falls back to JWT_SECRET)

# AI providers — set the keys you actually use
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=

# Mobile deploy (Expo / EAS) — optional
EXPO_TOKEN=
